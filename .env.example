# InspireX 环境变量（复制为 .env）

# 素材库根目录（原文件 + 缩略图 + inspirex.db）
INSPIREX_LIBRARY_PATH=

# 外置卷索引：不默认扫 /Volumes。界面「追加文件夹」可绑多个；若设具体卷路径才会自动加入
INSPIREX_BROWSE_ROOT=
INSPIREX_VOLUME_ROOTS_CONFIG=

# 本地库索引路径（JSON 列表，不默认家目录；也可用界面「追加文件夹」绑定多个）
INSPIREX_LOCAL_ROOT=
INSPIREX_LOCAL_ROOTS_CONFIG=

# 中转站：绑定云同步文件夹（iCloud / Dropbox 等）。也可在应用内点「绑定文件夹」
# INSPIREX_HUB_ROOT=
# 绑定路径持久化文件（默认 ~/InspireX/hub-root）
# INSPIREX_HUB_CONFIG=

# true = 确定性伪向量；false = 启动 scripts/clip_embed.py（需 torch+transformers）
AI_MOCK_MODE=true

# 真实 CLIP
CLIP_MODEL=openai/clip-vit-base-patch32
CLIP_PYTHON=python3
# CLIP_SIDECAR=scripts/clip_embed.py

# 浏览器插件本地采集端点（同时是浏览器主界面与 CLI 的 RPC）
INSPIREX_INGEST_PORT=18765
INSPIREX_INGEST_TOKEN=inspirex-local
# CLI 覆盖后端 URL（默认 http://127.0.0.1:$INSPIREX_INGEST_PORT）
# INSPIREX_CLI_BASE=

# 直接启动（图标 / npm run tauri -- dev / 封装 App）默认显示原生窗口。
# ./scripts/start.sh 会设为 false，隐藏窗口并用浏览器打开 http://127.0.0.1:1420
# INSPIREX_SHOW_WINDOW=true

# 来源二：订阅轮询默认间隔（分钟）
SUBSCRIBE_POLL_MIN=360

# 来源三：生图。CLIP 的 AI_MOCK_MODE 与生图独立。

# VPromptStore 图片提示词（AI生图 → prompt）。不复制仓库，只解析 Markdown 后写入本地库。
# VPROMPT_STORE_ROOT=/Volumes/Lexar/git/12 highvalue/VPromptStore
# INSPIREX_VPROMPT_CONFIG=
# MiniMax：生图用 image-01；文本/提示词挖掘用 MiniMax-M3（M3 不能出图）
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_API_KEY=
MINIMAX_TEXT_MODEL=MiniMax-M3
MINIMAX_OPENAI_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
# mock = 占位 PNG；minimax = MiniMax image-01；openai_compat = OpenAI Images 兼容网关
IMAGE_GEN_PROVIDER=minimax
IMAGE_GEN_BASE_URL=https://api.minimaxi.com
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=image-01
IMAGE_CAPTION_MODEL=MiniMax-M3
# 界面「设置」会写入该文件，优先于上方环境变量
# INSPIREX_AI_CONFIG=
TEXT_GEN_PROVIDER=minimax
TEXT_GEN_BASE_URL=https://api.minimaxi.com
TEXT_GEN_API_KEY=
TEXT_GEN_MODEL=MiniMax-M3
# VIDEO_GEN_PROVIDER=mock
# VIDEO_GEN_BASE_URL=
# VIDEO_GEN_API_KEY=
# VIDEO_GEN_MODEL=

# 日志级别：error | warn | info | debug
RUST_LOG=info

# 开发时前端端口（与 vite/tauri 配置一致）
VITE_DEV_PORT=1420
