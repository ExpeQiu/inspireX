{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InspireX",
  "version": "0.3.1",
  "identifier": "com.inspirex.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
        "windows": [
      {
        "label": "main",
        "title": "灵犀 InspireX",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data: http://127.0.0.1:18765 http://localhost:18765; media-src 'self' asset: http://asset.localhost blob: data: http://127.0.0.1:18765 http://localhost:18765; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:18765 http://localhost:18765 http://localhost:1420 http://127.0.0.1:1420 ws://localhost:1420 ws://localhost:1421",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "/Volumes/Q-V-P/**",
            "/Volumes/**",
            "$HOME/InspireX/**",
            "$HOME/**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "category": "public.app-category.photography"
  }
}
